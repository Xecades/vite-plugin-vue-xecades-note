{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "lib": ["esnext", "DOM"],
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "strict": true,
        "strictNullChecks": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true
    },
    "include": ["src/**/*.ts", "test/**/*.ts", "vite.config.ts"]
}
